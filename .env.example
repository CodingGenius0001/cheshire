ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID of the cloned voice (or a stock voice) from the ElevenLabs dashboard
ELEVENLABS_VOICE_ID=
# Optional voice tuning (defaults shown). Raise SIMILARITY if it doesn't sound
# like them, lower STABILITY for more expression, SPEED 0.7 to 1.2.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5   (eleven_multilingual_v2: closer match, slower)
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.85
# ELEVENLABS_SPEED=1
# Optional: Express port (Vite proxies /api here)
PORT=3001
